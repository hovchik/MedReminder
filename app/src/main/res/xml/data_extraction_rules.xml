<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup: excludes the medical database and sensitive preferences
  so that health data is NOT uploaded to Google Drive. This matches the
  Privacy Policy statement that user medical data stays on-device.

  Device-to-device transfer (local, user-initiated): the database and
  preferences ARE included so users can move their data when switching
  phones. This transfer does not leave the user's control.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="medreminder_db" />
        <exclude domain="database" path="medreminder_db-shm" />
        <exclude domain="database" path="medreminder_db-wal" />
        <exclude domain="database" path="medreminder_db-journal" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="medreminder_db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
